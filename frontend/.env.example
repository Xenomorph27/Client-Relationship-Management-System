# Copy to .env.local (which is git-ignored) to point the app at a real backend.
#
# LEAVE IT UNSET and the app runs on the sample data in src/mocks/db.js. That
# is what the Vercel deployment does, so the demo works with no backend at all.
#
# SET IT and every screen reads and writes the real database through FastAPI.
# No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000
