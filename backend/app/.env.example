# Copy this file to .env in the same folder and fill in real values.
# .env is git-ignored. Never commit real credentials.

# PostgreSQL connection string.
# Local development:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost/crm_db
# Managed Postgres (Neon, Supabase, Render) looks more like:
# DATABASE_URL=postgresql://user:password@host.region.provider.tech/dbname?sslmode=require

# SendGrid, for sending campaign and transactional email.
# Leave blank to disable sending. Use plain ASCII quotes or no quotes at all -
# a smart quote here causes a UnicodeDecodeError on startup.
SENDGRID_API_KEY=

# Origins allowed to call this API from a browser, comma separated.
# The Vite dev server, plus your deployed frontend once it exists.
CORS_ORIGINS=http://localhost:5173
