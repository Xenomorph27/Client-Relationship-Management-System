# Copy this file to .env in the same folder and fill in real values.
# .env is git-ignored. Never commit real credentials.

# PostgreSQL connection string.
# Local development:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost/crm_db
# Managed Postgres (Neon, Supabase, Render) looks more like:
# DATABASE_URL=postgresql://user:password@host.region.provider.tech/dbname?sslmode=require

# SendGrid, for sending campaign and transactional email.
# Leave blank to disable sending. Use plain ASCII quotes or no quotes at all -
# a smart quote here causes a UnicodeDecodeError on startup.
SENDGRID_API_KEY=

# Origins allowed to call this API from a browser, comma separated.
# The Vite dev server, plus your deployed frontend once it exists.
CORS_ORIGINS=http://localhost:5173

# --- Staff login (Supabase Auth) ---------------------------------------------
# true in every deployment. Only your own local .env may set false, to work on
# the API without signing in.
AUTH_REQUIRED=true
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=
# Only for older projects that still sign tokens with the legacy JWT secret.
SUPABASE_JWT_SECRET=
# Comma separated. Anyone listed here, or with a row on the People screen, is staff.
STAFF_EMAILS=

# --- Online shop (WooCommerce) -----------------------------------------------
WC_URL=https://sapphirewoodcrafts.co.uk
# WooCommerce > Settings > Advanced > REST API > Add key (Read access is enough)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# The "Secret" field of the WooCommerce webhooks (use the same one on all of them)
WC_WEBHOOK_SECRET=
# Minutes between catch-up syncs. 0 turns the timer off.
WC_SYNC_INTERVAL_MINUTES=15
# Shared with the website's "Sapphire CRM Bridge" plugin (Settings > Sapphire CRM)
WEBSITE_ENQUIRY_SECRET=

